  "typography": {
    "fontFamily": {
      "latin": "Roboto (Material Design 官方字体; Tk 落地回退系统 sans)",
      "cjk": "Noto Sans SC (macOS 回退 PingFang SC / Linux 回退 Noto Sans CJK SC)",
      "note": "Tk 只能用系统字体, 不得内置字体文件; 中文行高需按英文 1.2x 预留; 数字/英文标签(时间/元数据/overline)优先 Roboto, 中文及中英混排用 Noto Sans SC"
    },
    "scale": [
      { "name": "hero",     "px": 42, "weight": "bold",   "lineHeightPx": 50, "usage": "正在播放曲名 (Audirvana 大字层级)", "ttkStyle": "Hero.TLabel" },
      { "name": "heroFocus","px": 56, "weight": "bold",   "lineHeightPx": 68, "usage": "专注大屏曲名 (Audirvana 沉浸大字)", "ttkStyle": "HeroFocus.TLabel" },
      { "name": "title",    "px": 24, "weight": "bold",   "lineHeightPx": 30, "usage": "页面标题/专辑名", "ttkStyle": "Title.TLabel" },
      { "name": "subtitle", "px": 17, "weight": "normal", "lineHeightPx": 23, "usage": "副标题/歌手名", "ttkStyle": "Subtitle.TLabel" },
      { "name": "body",     "px": 14, "weight": "normal", "lineHeightPx": 20, "usage": "正文/列表项/参数标签", "ttkStyle": "TLabel" },
      { "name": "caption",  "px": 12, "weight": "normal", "lineHeightPx": 17, "usage": "元数据/歌词/帮助说明", "ttkStyle": "Caption.TLabel" },
